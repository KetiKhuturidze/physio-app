{
  "name": "physio-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "check": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage --coverageReporters=text-summary",
    "update:preview": "eas update --branch preview --message"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/src/$1",
      "\\.css$": "<rootDir>/__mocks__/fileMock.js"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|react-navigation|@react-navigation/.*|nativewind|react-native-css-interop|zustand)"
    ],
    "collectCoverageFrom": [
      "src/hooks/**/*.{ts,tsx}",
      "src/components/**/*.{ts,tsx}",
      "src/stores/**/*.{ts,tsx}",
      "src/lib/notifications.ts",
      "!src/**/*.d.ts"
    ]
  },
  "dependencies": {
    "@expo/ngrok": "^4.1.0",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.16",
    "@supabase/supabase-js": "^2.103.0",
    "babel-preset-expo": "~57.0.0",
    "base64-arraybuffer": "^1.0.2",
    "expo": "^57",
    "expo-constants": "~57.0.18",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.17",
    "expo-linking": "~57.0.10",
    "expo-location": "~57.0.17",
    "expo-notifications": "~57.0.18",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.22",
    "jimp-compact": "^0.16.1",
    "metro-config": "^0.84.3",
    "nativewind": "^4.2.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css-interop": "^0.2.3",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-worklets": "0.10.1",
    "react-refresh": "^0.18.0",
    "tailwindcss": "^3.4.19",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.4",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.1.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
